# wizard-ads web — environment template.
#
# Copy to `apps/web/.env.local` (gitignored) and fill in. NAMES are tracked here;
# VALUES never are. Secrets belong in the deployment platform's environment or in
# Supabase Vault, never in a file in this repository.
#
#   cp apps/web/env.TEMPLATE apps/web/.env.local

# --- Supabase Auth (magic link + Google) -----------------------------------
# Both are public by design: the anon key is a browser credential and is only
# useful together with row level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for exactly one operation: creating an email-confirmed Auth
# user after a valid organisation invitation has been atomically claimed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---------------------------------------------------------------
# A service-role Postgres connection string. Server-only: it is read in
# `src/data/db.ts` and never reaches a bundle.
DATABASE_URL=

# --- The app's own origin ---------------------------------------------------
# Used to build auth redirect targets. Taken from configuration rather than the
# request `Host` header, which a proxy can rewrite.
WIZARD_ADS_APP_URL=http://localhost:3000

# --- The MCP server's endpoint ----------------------------------------------
# Shown on `/connect-claude` for an operator to paste into their MCP client.
# This is NOT the web app's origin: `apps/mcp` is a separate deploy target, so
# it is never derived from WIZARD_ADS_APP_URL. The production endpoint is the
# safe default; set this only when deliberately targeting another deployment.
# The same name is read by other server-side consumers.
# WIZARD_ADS_MCP_URL=

# --- Amazon LWA -------------------------------------------------------------
# The client secret is the one true secret in this file. The redirect URI must
# match the LWA application's Allowed Return URLs byte for byte, and the new
# wizard-ads URI has to be registered there before any live attempt.
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=http://localhost:3000/api/amazon/oauth/callback

# HMAC key for the signed OAuth `state`. At least 32 bytes:
#   openssl rand -base64 48
AMAZON_OAUTH_STATE_KEY=

# --- Optional overrides -----------------------------------------------------
# Real Amazon endpoints are the defaults; these exist so the end-to-end suite
# can point the whole flow at a local mock.
# AMAZON_LWA_AUTHORIZE_URL=https://www.amazon.com/ap/oa
# AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
# AMAZON_ADS_HOST_NA=https://advertising-api.amazon.com
# AMAZON_ADS_HOST_EU=https://advertising-api-eu.amazon.com
# AMAZON_ADS_HOST_FE=https://advertising-api-fe.amazon.com

# Send the OAuth nonce cookie with the `__Host-` prefix and `Secure`. Defaults
# to on in production, off otherwise (browsers refuse `__Host-` over http).
# WIZARD_ADS_SECURE_COOKIES=1

# --- Test only --------------------------------------------------------------
# There are two test-only authentication seams, one per browser suite, and both
# are set by `e2e/run.ts` rather than by hand. Never set either on a deployed
# instance. See `src/server/request-context.ts` for the boundary between them.
#
# WP-04's auth/oauth/roles suite. Accepts a session cookie the real login flow
# never issues, so Playwright can sign in without a mailbox. The app refuses to
# start with this set in a production build.
# WIZARD_ADS_E2E_AUTH=1
#
# WP-08's tags/goto suite, which must serve a production build and so cannot use
# the seam above. Arms a header bridge carrying an already-verified actor. It
# throws on use if Supabase Auth is also configured, so the two identity sources
# can never both be live.
# WIZARD_ADS_E2E_AUTH_BRIDGE=1
# WIZARD_ADS_AUTH_BRIDGE_SECRET=
#
# Signing key for `/go/[token]` short links. Server-only.
# GOTO_LINK_SIGNING_SECRET=
