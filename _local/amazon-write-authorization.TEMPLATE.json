{
  "schema": "openspell.amazon-write-authorization.v1",
  "authorization_id": "<single-use authorization UUID>",
  "expires_at": "<ISO-8601 timestamp>",
  "profiles": [
    {
      "org_id": "<internal organization UUID>",
      "profile_id": "<internal advertising profile UUID>",
      "amazon_profile_id": "<external Amazon advertising profile ID>",
      "connection_id": "<internal Amazon connection UUID>",
      "region": "<NA | EU | FE>",
      "account_label": "<local account label>",
      "marketplace": "<marketplace code>",
      "allowed_entities": [
        {
          "action_type": "<sp_keyword_bid | sp_target_bid | sp_campaign_placement>",
          "amazon_entity_id": "<exact Amazon entity ID>",
          "field": "<bid | top_of_search | product_pages | rest_of_search>"
        }
      ]
    }
  ],
  "allowed_tests": {
    "bid": {
      "enabled": false,
      "max_absolute_delta": "<currency amount>",
      "require_immediate_inverse": true
    },
    "placement": {
      "enabled": false,
      "max_absolute_percentage_points": "<integer>",
      "require_immediate_inverse": true
    },
    "cadence": {
      "enabled": false,
      "max_executions": "<integer>",
      "disable_after_test": true,
      "require_immediate_inverse": true
    }
  },
  "constraints": {
    "max_concurrent_mutations": 1,
    "max_rows_per_execution": 1,
    "max_total_executions": 2,
    "require_current_value_match": true,
    "require_amazon_acceptance": true,
    "require_sync_observation_before_inverse": true,
    "stop_on_conflict": true
  }
}
