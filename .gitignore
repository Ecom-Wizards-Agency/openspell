# Dependencies and build output
node_modules/
dist/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# Playwright run output (traces, reports, per-test artifacts).
test-results/
playwright-report/
blob-report/

# Generated by `next typegen`, which the web typecheck runs first. It references
# files under .next/, so a committed copy breaks a clean clone.
next-env.d.ts

# Secrets and environment
.env*

# Per-operator local config. Only templates are tracked.
_local/*
!_local/*.TEMPLATE.*

# Golden fixtures generated from a local run stay local.
fixtures/golden/**/*.local.*

# OS noise
.DS_Store

# agent worktrees
.claude/
.vercel/
